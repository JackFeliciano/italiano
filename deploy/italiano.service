[Unit]
Description=Smart Italiano demo
After=network.target

[Service]
Type=simple
User=opc
Group=opc
WorkingDirectory=/srv/italiano
Environment=ITALIANO_BASE=/italiano/
ExecStart=/usr/bin/php -S 127.0.0.1:8119 -t showroom showroom/index.php
Restart=on-failure
RestartSec=2

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/italiano
MemoryDenyWriteExecute=false

[Install]
WantedBy=multi-user.target
